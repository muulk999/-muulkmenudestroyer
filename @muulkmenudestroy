            local randomAngleY = math.rad(math.random(0, 360))
            local randomAngleZ = math.rad(math.random(0, 360))
            
            rootPart.CFrame = targetRoot.CFrame * CFrame.new(offsetX, offsetY, offsetZ) * CFrame.Angles(randomAngleX, randomAngleY, randomAngleZ)
         end
      end)

      task.wait(3.0)
      if connection then connection:Disconnect() end

      rootPart.CFrame = originalCFrame - Vector3.new(0, 30, 0)
      rootPart.Anchored = true

      task.wait(3.0)

      if couchTool and couchTool.Parent == character then
         couchTool.Parent = backpack
      end

      rootPart.Anchored = false
      rootPart.CFrame = originalCFrame

      Rayfield:Notify({ Title = "Trolagem Concluída 🇧🇷 | Trolling Completed 🇺🇸", Content = "Ação 'sofá morte' finalizada! 🇧🇷 | Action finished! 🇺🇸", Duration = 3, Image = 4483362458 })
