            targetCFrame = mainPart.CFrame + Vector3.new(0, 3, 0)
         elseif couchObject:IsA("Model") and couchObject.PrimaryPart then
            targetCFrame = couchObject.PrimaryPart.CFrame + Vector3.new(0, 3, 0)
         end
         
         if targetCFrame then
            humanoidRootPart.CFrame = targetCFrame
            Rayfield:Notify({ Title = "Sucesso! 🇧🇷 | Success! 🇺🇸", Content = "Você foi teletransportado para o sofá! 🇧🇷 | Teleported to the couch! 🇺🇸", Duration = 3.5, Image = 4483362458 })
