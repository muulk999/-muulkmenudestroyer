      local character = player.Character or player.CharacterAdded:Wait()
      local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
      
      if not humanoidRootPart then return end

      local couchObject = findCouchInWorld()
      if couchObject then
         local targetCFrame = nil
         local seat1 = couchObject:FindFirstChild("Seat1")
         local mainPart = couchObject:FindFirstChild("Main") or couchObject:FindFirstChildWhichIsA("BasePart")
         
         if seat1 and seat1:IsA("BasePart") then
