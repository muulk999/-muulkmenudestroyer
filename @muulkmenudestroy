         task.spawn(function()
            while vehicleLoopActive do
               local player = game.Players.LocalPlayer
               local character = player.Character
               
               if not character or not character:FindFirstChild("HumanoidRootPart") then
                  task.wait(1)
                  continue
               end

               if not selectedVehiclePlayerName or selectedVehiclePlayerName == "Nenhum player 🇧🇷 | No player 🇺🇸" then
                  task.wait(1)
                  continue
               end

               local targetPlayer = game.Players:FindFirstChild(selectedVehiclePlayerName)
               if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                  task.wait(1)
                  continue
               end

               local services = {
                  game:GetService("Workspace"),
                  game:GetService("ReplicatedStorage"),
                  game:GetService("Lighting"),
                  game:GetService("ServerStorage")
               }

               local vehiclesFolder = nil
               for _, service in ipairs(services) do
                  local found = service:FindFirstChild("Vehicles", true)
                  if found then
                     vehiclesFolder = found
                     break
                  end
               end

               if not vehiclesFolder then
                  task.wait(2)
                  continue
               end

               local availableVehicles = {}
               for _, item in ipairs(vehiclesFolder:GetChildren()) do
                  if item:IsA("Model") then
                     table.insert(availableVehicles, item)
                  end
               end

               if #availableVehicles == 0 then
                  task.wait(2)
                  continue
               end

               local originalCFrame = character.HumanoidRootPart.CFrame
               local rootPart = character.HumanoidRootPart
               local humanoid = character:FindFirstChildOfClass("Humanoid")
               local runService = game:GetService("RunService")

               local randomVehicleTemplate = availableVehicles[math.random(1, #availableVehicles)]
               local vehicleClone = randomVehicleTemplate:Clone()
               vehicleClone.Parent = workspace

               local centerCFrame, size = vehicleClone:GetBoundingBox()
               local distanceZ = math.max(size.Z * 0.8, 10)

               local gestureStartTime = tick()
               local activeGesture = true
               
               local conn
               conn = runService.RenderStepped:Connect(function()
                  local t = tick() - gestureStartTime
                  if t >= 3.0 or not activeGesture or not vehicleLoopActive then
                     if conn then conn:Disconnect() end
                     return
                  end

                  local offsetZ = math.sin(t * 12) * distanceZ
                  local offsetY = 2 + (math.cos(t * 16) * 2.5)
                  
                  rootPart.CFrame = centerCFrame * CFrame.new(0, offsetY, offsetZ)
               end)

               task.wait(3.0)
               activeGesture = false
               if conn then conn:Disconnect() end

               if not vehicleLoopActive then break end

               if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                  local targetRoot = targetPlayer.Character.HumanoidRootPart
                  rootPart.CFrame = targetRoot.CFrame + Vector3.new(0, 6, 0)
               end

               if humanoid then
                  humanoid.Sit = false
                  humanoid.Jump = true
               end
               task.wait(0.35)

               rootPart.CFrame = originalCFrame
               task.wait(0.4)
            end
         end)
      else
         Rayfield:Notify({ Title = "Desativado 🇧🇷 | Disabled 🇺🇸", Content = "Encerrado. 🇧🇷 | Ended. 🇺🇸", Duration = 2, Image = 4483362458 })
      end
   end,
})

