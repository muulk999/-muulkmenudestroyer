         Rayfield:Notify({ Title = "Erro 🇧🇷 | Error 🇺🇸", Content = "O player selecionado não está no jogo ou morreu. 🇧🇷 | Selected player is not in game or died. 🇺🇸", Duration = 3, Image = 4483362458 })
         return
      end

      local originalCFrame = character.HumanoidRootPart.CFrame

      local backpack = player:FindFirstChild("Backpack")
      local couchTool = nil
      if backpack then couchTool = backpack:FindFirstChild("Couch") end
      if not couchTool then couchTool = character:FindFirstChild("Couch") end

      if couchTool and couchTool:IsA("Tool") then
         couchTool.Parent = character
      else
         Rayfield:Notify({ Title = "Aviso 🇧🇷 | Warning 🇺🇸", Content = "Item 'Couch' não encontrado na Backpack! 🇧🇷 | Item 'Couch' not found in Backpack! 🇺🇸", Duration = 3, Image = 4483362458 })
      end

      task.wait(0.1)

      local rootPart = character.HumanoidRootPart
      local runService = game:GetService("RunService")
      local startTime = tick()
      
      local connection
      connection = runService.RenderStepped:Connect(function()
         if tick() - startTime >= 3 then
            if connection then connection:Disconnect() end
            return
         end

         if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = targetPlayer.Character.HumanoidRootPart
            local offsetX = (math.random() - 0.5) * 8
            local offsetY = (math.random() - 0.5) * 6
            local offsetZ = (math.random() - 0.5) * 8
            
