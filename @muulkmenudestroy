local VisualTab = Window:CreateTab("VISUAL 🇧🇷 | VISUAL 🇺🇸", 4483362458)
local VisualSection = VisualTab:CreateSection("Aura de Itens do Backpack 🇧🇷 | Backpack Items Aura 🇺🇸")

local circleHackActive = false
local orbitDistance = 6
local maxItemsCount = 3
local itemMultiplier = 2

local circleFolder = workspace:FindFirstChild("CircleHack_Folder") or Instance.new("Folder")
circleFolder.Name = "CircleHack_Folder"
circleFolder.Parent = workspace

VisualTab:CreateToggle({
   Name = "CIRCULO HACK 🇧🇷 | CIRCLE HACK 🇺🇸",
   CurrentValue = false,
   Flag = "CircleHackToggle",
   Callback = function(Value)
      circleHackActive = Value

      if not circleHackActive then
         circleFolder:ClearAllChildren()
         return
      end

      task.spawn(function()
         local runService = game:GetService("RunService")
         local player = game.Players.LocalPlayer
         local character = player.Character or player.CharacterAdded:Wait()
         
         if not character or not character:FindFirstChild("HumanoidRootPart") then return end

         circleFolder:ClearAllChildren()

         local backpackItems = {}
         if player:FindFirstChild("Backpack") then
            for _, item in ipairs(player.Backpack:GetChildren()) do
               if item:IsA("Tool") then
                  table.insert(backpackItems, item)
               end
            end
         end
         
         for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
               table.insert(backpackItems, item)
            end
         end

         if #backpackItems == 0 then
            Rayfield:Notify({ Title = "Aviso 🇧🇷 | Warning 🇺🇸", Content = "Nenhum item/tool encontrado no seu inventário! 🇧🇷 | No item/tool found in your inventory! 🇺🇸", Duration = 3, Image = 4483362458 })
            circleHackActive = false
            return
         end

         local spawnedModels = {}
         local limit = math.min(maxItemsCount, #backpackItems)

         for i = 1, limit do
            local itemTemplate = backpackItems[i]
            for m = 1, itemMultiplier do
               local clonedItem = itemTemplate:Clone()
               
               for _, desc in ipairs(clonedItem:GetDescendants()) do
                  if desc:IsA("LuaSourceContainer") or desc:IsA("Sound") or desc:IsA("TouchTransmitter") then
                     desc:Destroy()
                  elseif desc:IsA("BasePart") then
                     desc.CanCollide = false
                     desc.Anchored = true
                  end
               end
               
               clonedItem.Parent = circleFolder
               table.insert(spawnedModels, clonedItem)
            end
         end

         local startTime = tick()
         local renderConnection

         renderConnection = runService.RenderStepped:Connect(function()
            if not circleHackActive or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
               if renderConnection then renderConnection:Disconnect() end
               circleFolder:ClearAllChildren()
               return
            end

            local t = (tick() - startTime) * 0.5
            local currentRoot = player.Character.HumanoidRootPart
            local total = #spawnedModels

            for i, model in ipairs(spawnedModels) do
               if model and model.Parent then
                  local angle = t + ((i / total) * (math.pi * 2))
                  local posX = math.cos(angle) * orbitDistance
                  local posZ = math.sin(angle) * orbitDistance
                  local posY = math.sin(t * 0.8 + i) * 1.2
                  
                  local targetPos = currentRoot.Position + Vector3.new(posX, posY, posZ)
                  
                  local rx = math.rad(t * 30 + (i * 20))
                  local ry = math.rad(t * 40 + (i * 35))
                  local rz = math.rad(t * 25 + (i * 15))

                  local newCFrame = CFrame.new(targetPos) * CFrame.Angles(rx, ry, rz)

                  if model:IsA("Model") then
                     if model.PrimaryPart then
                        model:SetPrimaryPartCFrame(newCFrame)
                     else
                        local p = model:FindFirstChildWhichIsA("BasePart")
                        if p then
                           model.PrimaryPart = p
                           model:SetPrimaryPartCFrame(newCFrame)
                        end
                     end
                  elseif model:IsA("Tool") then
                     local handle = model:FindFirstChild("Handle") or model:FindFirstChildWhichIsA("BasePart")
                     if handle then
                        handle.CFrame = newCFrame
                     end
                  end
               end
            end
         end)
      end)
   end,
})

