PlayerTab:CreateToggle({
   Name = "Ativar Anti-Void (Voltar ao Lobby ao Cair) 🇧🇷 | Enable Anti-Void (Return to Lobby on Fall) 🇺🇸",
   CurrentValue = false,
   Flag = "AntiVoidToggle",
   Callback = function(Value)
      antiVoidActive = Value

      if antiVoidActive then
         Rayfield:Notify({ Title = "Anti-Void Ativado 🇧🇷 | Anti-Void Enabled 🇺🇸", Content = "Você será salvo se cair no vazio! 🇧🇷 | You will be saved if you fall into the void! 🇺🇸", Duration = 2.5, Image = 4483362458 })
         
         antiVoidConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if not antiVoidActive then return end
            local player = game.Players.LocalPlayer
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
               local root = character.HumanoidRootPart
               if root.Position.Y < -50 then
                  local spawnCFrame = nil
                  local spawns = workspace:GetDescendants()
                  for _, obj in ipairs(spawns) do
                     if obj:IsA("SpawnLocation") then
                        spawnCFrame = obj.CFrame + Vector3.new(0, 5, 0)
                        break
                     end
                  end
                  
                  if not spawnCFrame then
                     spawnCFrame = CFrame.new(0, 10, 0)
                  end

                  root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                  root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                  root.CFrame = spawnCFrame

                  Rayfield:Notify({ Title = "Salvo pelo Anti-Void! 🇧🇷 | Saved by Anti-Void! 🇺🇸", Content = "Você foi teletransportado de volta para o Lobby. 🇧🇷 | You were teleported back to the Lobby. 🇺🇸", Duration = 3, Image = 4483362458 })
               end
            end
         end)
      else
         if antiVoidConnection then antiVoidConnection:Disconnect() end
         Rayfield:Notify({ Title = "Anti-Void Desativado 🇧🇷 | Anti-Void Disabled 🇺🇸", Content = "Proteção contra quedas desligada. 🇧🇷 | Fall protection turned off. 🇺🇸", Duration = 2.5, Image = 4483362458 })
