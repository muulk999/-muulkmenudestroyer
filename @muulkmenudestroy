local holdPlayerActive = false
local holdConnection = nil

PlayerTab:CreateToggle({
   Name = "SEGURAR PLAYER NA MÃO (Ativar/Desativar) 🇧🇷 | HOLD PLAYER IN HAND (Enable/Disable) 🇺🇸",
   CurrentValue = false,
   Flag = "HoldPlayerToggle",
   Callback = function(Value)
      holdPlayerActive = Value

      if holdPlayerActive then
         if not selectedHoldPlayerName or selectedHoldPlayerName == "Nenhum player 🇧🇷 | No player 🇺🇸" then
            Rayfield:Notify({ Title = "Aviso 🇧🇷 | Warning 🇺🇸", Content = "Selecione um player na lista primeiro! 🇧🇷 | Select a player from the list first! 🇺🇸", Duration = 3, Image = 4483362458 })
            holdPlayerActive = false
            return
         end

         local targetPlayer = game.Players:FindFirstChild(selectedHoldPlayerName)
         if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            Rayfield:Notify({ Title = "Erro 🇧🇷 | Error 🇺🇸", Content = "O player selecionado não foi encontrado ou está morto. 🇧🇷 | Selected player not found or dead. 🇺🇸", Duration = 3, Image = 4483362458 })
            holdPlayerActive = false
            return
         end

         Rayfield:Notify({ Title = "Segurando Player 🇧🇷 | Holding Player 🇺🇸", Content = "Você pegou " .. selectedHoldPlayerName .. " na mão! 🇧🇷 | You picked up " .. selectedHoldPlayerName .. " in your hand! 🇺🇸", Duration = 2.5, Image = 4483362458 })

         local runService = game:GetService("RunService")
         holdConnection = runService.RenderStepped:Connect(function()
            if not holdPlayerActive then
               if holdConnection then holdConnection:Disconnect() end
               return
            end

            local player = game.Players.LocalPlayer
            local character = player.Character
            local currentTarget = game.Players:FindFirstChild(selectedHoldPlayerName)

            if character and character:FindFirstChild("Right Arm") or character:FindFirstChild("RightHand") then
               local rightArm = character:FindFirstChild("RightArm") or character:FindFirstChild("RightHand")
               
               if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") then
                  local targetRoot = currentTarget.Character.HumanoidRootPart
                  local targetHumanoid = currentTarget.Character:FindFirstChildOfClass("Humanoid")
                  
                  if targetHumanoid then
                     targetHumanoid.PlatformStand = true
                  end

                  targetRoot.CFrame = rightArm.CFrame * CFrame.new(0, -1.2, 0) * CFrame.Angles(math.rad(90), 0, 0)
                  targetRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                  targetRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
               end
            end
         end)
      else
         if holdConnection then holdConnection:Disconnect() end
         
         local targetPlayer = game.Players:FindFirstChild(selectedHoldPlayerName)
         if targetPlayer and targetPlayer.Character then
            local targetHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            if targetHumanoid then
               targetHumanoid.PlatformStand = false
            end
         end

         Rayfield:Notify({ Title = "Solto 🇧🇷 | Released 🇺🇸", Content = "Você soltou o jogador. 🇧🇷 | You released the player. 🇺🇸", Duration = 2, Image = 4483362458 })
      end
   end,
})

