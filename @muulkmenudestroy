local vehicleSpinActive = false

TrollTab:CreateToggle({
   Name = "GIRO COM VEÍCULO 🇧🇷 | VEHICLE SPIN 🇺🇸",
   CurrentValue = false,
   Flag = "VehicleSpinToggle",
   Callback = function(Value)
      vehicleSpinActive = Value

      if vehicleSpinActive then
         Rayfield:Notify({ Title = "Ativado 🇧🇷 | Enabled 🇺🇸", Content = "Giro iniciado! 🇧🇷 | Spin started! 🇺🇸", Duration = 2, Image = 4483362458 })

         task.spawn(function()
            local player = game.Players.LocalPlayer
            local runService = game:GetService("RunService")

            while vehicleSpinActive do
               local character = player.Character
               if not character or not character:FindFirstChild("HumanoidRootPart") then
                  task.wait(1)
                  continue
               end

               local rootPart = character.HumanoidRootPart
               local humanoid = character:FindFirstChildOfClass("Humanoid")
               
               local originCFrame = rootPart.CFrame
               local originPos = originCFrame.Position
               local fixedY = originPos.Y

               local services = {
                  game:GetService("Workspace"),
                  game:GetService("ReplicatedStorage"),
                  game:GetService("Lighting"),
                  game:GetService("ServerStorage")
               }

               local vehiclesFolder = nil
               for _, service in ipairs(services) do
                  local found = service:FindFirstChild("Vehicles", true)
                  if found then
                     vehiclesFolder = found
                     break
                  end
               end

               local vehicleClone = nil
               if vehiclesFolder then
                  local available = {}
                  for _, item in ipairs(vehiclesFolder:GetChildren()) do
                     if item:IsA("Model") then table.insert(available, item) end
                  end
                  if #available > 0 then
                     vehicleClone = available[math.random(1, #available)]:Clone()
                     vehicleClone.Parent = workspace
                  end
               end

               local cycleStartTime = tick()
               local isSpinning = true

               local conn
               conn = runService.RenderStepped:Connect(function()
                  if not vehicleSpinActive or not isSpinning or not character:FindFirstChild("HumanoidRootPart") then
                     if conn then conn:Disconnect() end
                     return
                  end

                  local elapsed = tick() - cycleStartTime
                  local duration = 6.0
                  local progress = (elapsed % duration) / duration

                  local radiusProgress = math.sin(progress * math.pi) 
                  local currentRadius = radiusProgress * 300 

                  local speedMultiplier = 6 + (radiusProgress * 35)
                  local angle = elapsed * speedMultiplier

                  local offsetX = math.cos(angle) * currentRadius
                  local offsetZ = math.sin(angle) * currentRadius

                  local newPosition = Vector3.new(originPos.X + offsetX, fixedY, originPos.Z + offsetZ)

                  local targetCFrame
                  if (newPosition - originPos).Magnitude > 0.1 then
                     targetCFrame = CFrame.lookAt(newPosition, originPos)
                  else
                     targetCFrame = originCFrame
                  end

                  rootPart.CFrame = targetCFrame

                  if vehicleClone and vehicleClone.PrimaryPart then
                     vehicleClone:SetPrimaryPartCFrame(targetCFrame)
                  end
               end)

               while vehicleSpinActive and character:FindFirstChild("HumanoidRootPart") do
                  task.wait(0.1)
               end

               isSpinning = false
               if conn then conn:Disconnect() end

               if vehicleClone then
                  vehicleClone:Destroy()
               end

               if humanoid then
                  humanoid.Sit = false
                  humanoid.Jump = true
               end

               rootPart.CFrame = originCFrame
               task.wait(0.2)
            end
         end)
      else
         Rayfield:Notify({ Title = "Desativado 🇧🇷 | Disabled 🇺🇸", Content = "Finalizado. 🇧🇷 | Finished. 🇺🇸", Duration = 2, Image = 4483362458 })
      end
   end,
})

